# Copiar para infra/.env se quiser mudar algo. Sem .env, o docker-compose usa estes mesmos padrões.
# Senhas abaixo são só de desenvolvimento local. Não usar em print nem no relatório.

POSTGRES_USER=ecopulse
POSTGRES_PASSWORD=ecopulse_dev
POSTGRES_DB=ecopulse
POSTGRES_PORTA=5432

REDIS_PORTA=6379

RABBITMQ_USER=ecopulse
RABBITMQ_PASSWORD=ecopulse_dev
# Portas do host. 5673/15673 porque um RabbitMQ local do Windows pode já ocupar 5672/15672.
RABBITMQ_PORTA=5673
RABBITMQ_PAINEL_PORTA=15673

API_PORTA=3000

# Filas (fixas no código, em packages/contratos):
# ecopulse.relatos.recebido  -> DLQ ecopulse.relatos.dlq
# ecopulse.clima.solicitado  -> DLQ ecopulse.clima.dlq
